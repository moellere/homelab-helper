 _LOGGER = logging.getLogger(__name__)
@@ -45,7 +46,7 @@ class GoogleWeatherApi:
         self.referrer = referrer
         self.timeout = aiohttp.ClientTimeout(total=timeout)
 
-    async def _async_get(self, endpoint: str, params: dict[str, Any]) -> dict[str, Any]:
+    async def _async_get(self, endpoint: str, params: dict[str, Any], *, include_language_code: bool = True) -> dict[str, Any]:
         """Perform a GET request."""
         url = f"{_BASE_URL}/{endpoint}"
         headers = {aiohttp.hdrs.USER_AGENT: _USER_AGENT}
@@ -54,9 +55,10 @@ class GoogleWeatherApi:
         params = {
             **params,
             "key": self.api_key,
-            "language_code": self.language_code,
             "units_system": self.units_system,
         }
+        if include_language_code:
+            params["language_code"] = self.language_code
         _LOGGER.debug("GET %s with params: %s", url, params)
         try:
             async with self.session.get(
@@ -132,3 +134,23 @@ class GoogleWeatherApi:
             },
         )
         return DailyForecastResponse.from_dict(data)
+
+    async def async_get_minute_forecast(
+        self, latitude: float, longitude: float, page_size: int = 360
+    ) -> MinuteForecastResponse:
+        """Fetch minute-by-minute precipitation nowcast for up to 6 hours.
+
+        The endpoint does not accept language_code (reserved field in google.maps.weather.v1).
+
+        See https://developers.google.com/maps/documentation/weather/minute-forecast
+        """
+        data = await self._async_get(
+            "forecast/minutes:lookup",
+            {
+                "location.latitude": latitude,
+                "location.longitude": longitude,
+                "page_size": page_size,
+            },
+            include_language_code=False,
+        )
+        return MinuteForecastResponse.from_dict(data)
diff --git a/src/google_weather_api/model.py b/src/google_weather_api/model.py
index 005118d..940c4e0 100644
--- a/src/google_weather_api/model.py
+++ b/src/google_weather_api/model.py
@@ -603,3 +603,64 @@ class HourlyForecastResponse(DataClassJSONMixin):
 
     next_page_token: str | None = field(default=None, metadata={"alias": "nextPageToken"})
     """The token to retrieve the next page."""
+
+
+@dataclass
+class PrecipitationSegment(DataClassJSONMixin):
+    """Represents a segment of precipitation forecast data."""
+
+    class DominantPrecipitationType(StrEnum):
+        """Represents the type of precipitation of a segment."""
+
+        DOMINANT_PRECIPITATION_TYPE_UNSPECIFIED = "DOMINANT_PRECIPITATION_TYPE_UNSPECIFIED"
+        NONE = "NONE"
+        RAIN = "RAIN"
+        SNOW = "SNOW"
+        HAIL = "HAIL"
+
+    class PrecipitationIntensity(StrEnum):
+        """Represents the precipitation intensity of a segment."""
+
+        PRECIPITATION_INTENSITY_UNSPECIFIED = "PRECIPITATION_INTENSITY_UNSPECIFIED"
+        NO_INTENSITY = "NO_INTENSITY"
+        LIGHT = "LIGHT"
+        MID_LIGHT = "MID_LIGHT"
+        MODERATE = "MODERATE"
+        MID_MODERATE = "MID_MODERATE"
+        HEAVY = "HEAVY"
+        MID_HEAVY = "MID_HEAVY"
+
+    time_frame: Interval = field(metadata={"alias": "timeFrame"})
+    """The timeframe relevant to the segment."""
+
+    type: DominantPrecipitationType = DominantPrecipitationType.DOMINANT_PRECIPITATION_TYPE_UNSPECIFIED
+    """A code that indicates the type of precipitation."""
+
+    probability: int = 0
+    """The chance of precipitation (values from 0 to 100)."""
+
+    qpf: QuantitativePrecipitationForecast | None = None
+    """The amount of precipitation, measured as liquid water equivalent."""
+
+    snowfall_amount: QuantitativePrecipitationForecast | None = field(default=None, metadata={"alias": "snowfallAmount"})
+    """The amount of snow accumulation, measured as liquid water equivalent."""
+
+    intensity: PrecipitationIntensity = PrecipitationIntensity.PRECIPITATION_INTENSITY_UNSPECIFIED
+    """A code that indicates the precipitation intensity of the segment."""
+
+
+@dataclass
+class MinuteForecastResponse(DataClassJSONMixin):
+    """Response model for the forecast.minutes.lookup method."""
+
+    overall_prediction_timeframe: Interval = field(metadata={"alias": "overallPredictionTimeframe"})
+    """The overall timeframe for the predictions."""
+
+    time_zone: TimeZone = field(metadata={"alias": "timeZone"})
+    """The time zone at the requested location."""
+
+    segments: list[PrecipitationSegment] = field(default_factory=list)
+    """The minute-level prediction segments."""
+
+    next_page_token: str | None = field(default=None, metadata={"alias": "nextPageToken"})
+    """The token to retrieve the next page."""
diff --git a/tests/test_minute_forecast.py b/tests/test_minute_forecast.py
new file mode 100644
index 0000000..8c92bad
--- /dev/null
+++ b/tests/test_minute_forecast.py
@@ -0,0 +1,77 @@
+"""Tests for the minute forecast models."""
+
+from google_weather_api import MinuteForecastResponse, PrecipitationSegment
+
+SAMPLE_RESPONSE = {
+    "overallPredictionTimeframe": {
+        "startTime": "2026-08-10T14:00:00Z",
+        "endTime": "2026-08-10T20:00:00Z",
+    },
+    "timeZone": {"id": "America/New_York"},
+    "segments": [
+        {
+            "timeFrame": {
+                "startTime": "2026-08-10T14:00:00Z",
+                "endTime": "2026-08-10T14:01:00Z",
+            },
+            "type": "RAIN",
+            "probability": 62,
+            "qpf": {"quantity": 0.5, "unit": "MILLIMETERS"},
+            "snowfallAmount": {"quantity": 0, "unit": "MILLIMETERS"},
+            "intensity": "MODERATE",
+        },
+        {
+            "timeFrame": {
+                "startTime": "2026-08-10T14:01:00Z",
+                "endTime": "2026-08-10T14:02:00Z",
+            },
+            "type": "NONE",
+            "intensity": "NO_INTENSITY",
+        },
+    ],
+    "nextPageToken": "token123",
+}
+
+
+def test_minute_forecast_response_from_dict() -> None:
+    """Test parsing a full minute forecast response."""
+    response = MinuteForecastResponse.from_dict(SAMPLE_RESPONSE)
+    assert response.overall_prediction_timeframe.start_time == "2026-08-10T14:00:00Z"
+    assert response.overall_prediction_timeframe.end_time == "2026-08-10T20:00:00Z"
+    assert response.time_zone.id == "America/New_York"
+    assert response.next_page_token == "token123"  # noqa: S105
+    assert len(response.segments) == 2
+
+    wet = response.segments[0]
+    assert wet.time_frame.start_time == "2026-08-10T14:00:00Z"
+    assert wet.type is PrecipitationSegment.DominantPrecipitationType.RAIN
+    assert wet.probability == 62
+    assert wet.qpf is not None
+    assert wet.qpf.quantity == 0.5
+    assert wet.qpf.unit == "MILLIMETERS"
+    assert wet.snowfall_amount is not None
+    assert wet.snowfall_amount.quantity == 0
+    assert wet.intensity is PrecipitationSegment.PrecipitationIntensity.MODERATE
+
+
+def test_minute_forecast_segment_defaults() -> None:
+    """Test parsing a segment with proto3-default fields omitted."""
+    response = MinuteForecastResponse.from_dict(SAMPLE_RESPONSE)
+    dry = response.segments[1]
+    assert dry.type is PrecipitationSegment.DominantPrecipitationType.NONE
+    assert dry.probability == 0
+    assert dry.qpf is None
+    assert dry.snowfall_amount is None
+    assert dry.intensity is PrecipitationSegment.PrecipitationIntensity.NO_INTENSITY
+
+
+def test_minute_forecast_response_without_segments() -> None:
+    """Test parsing a response where the segments list is omitted."""
+    response = MinuteForecastResponse.from_dict(
+        {
+            "overallPredictionTimeframe": {"startTime": "2026-08-10T14:00:00Z"},
+            "timeZone": {"id": "America/New_York"},
+        }
+    )
+    assert response.segments == []
+    assert response.next_page_token is None
